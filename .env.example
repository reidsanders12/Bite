USDA_API_KEY="your-usda-key"            # https://fdc.nal.usda.gov/api-key-signup (or leave blank for DEMO_KEY)
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
ADMIN_EMAIL="you@example.com"           # optional -- unlocks Profile -> Sponsor Requests / Reported Posts for this account
PRIVACY_POLICY_URL=""                   # optional -- once you host privacy_policy.html, set its URL to show Profile -> Privacy Policy
ACCOUNT_DELETION_URL=""                 # optional -- once you host account_deletion.html, set its URL to show Profile -> Delete My Data (Web)
